{
  "name": "codex-local-bridge-remote",
  "displayName": "Codex Local Bridge — Remote",
  "description": "为远程 Codex 与 Claude Code 提供经本机 CC Switch 出网的回环 API 桥接。",
  "version": "0.3.0",
  "publisher": "vectory-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vectory-local.codex-local-bridge-local"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexLocalBridge.remote.version"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexLocalBridge.start",
        "title": "Codex Local Bridge: 启动远程桥接"
      },
      {
        "command": "codexLocalBridge.stop",
        "title": "Codex Local Bridge: 停止远程桥接"
      },
      {
        "command": "codexLocalBridge.diagnose",
        "title": "Codex Local Bridge: 检查本机出口"
      },
      {
        "command": "codexLocalBridge.configureCodex",
        "title": "Codex Local Bridge: 配置远程 Codex"
      },
      {
        "command": "codexLocalBridge.showConfig",
        "title": "Codex Local Bridge: 显示现有 Codex 的配置片段"
      },
      {
        "command": "codexLocalBridge.selectModel",
        "title": "Codex Local Bridge: 选择模型并显示配置"
      },
      {
        "command": "codexLocalBridge.openTerminal",
        "title": "Codex Local Bridge: 打开远程 Codex 终端"
      },
      {
        "command": "codexLocalBridge.showClaudeConfig",
        "title": "Codex Local Bridge: 显示远程 Claude 配置"
      },
      {
        "command": "codexLocalBridge.openClaudeTerminal",
        "title": "Codex Local Bridge: 打开远程 Claude 终端"
      },
      {
        "command": "codexLocalBridge.diagnoseClaude",
        "title": "Codex Local Bridge: 检查 Claude 出口"
      }
    ],
    "configuration": {
      "title": "Codex Local Bridge",
      "properties": {
        "codexLocalBridge.remotePort": {
          "type": "integer",
          "default": 35721,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "machine",
          "description": "远程回环 HTTP 代理端口。"
        },
        "codexLocalBridge.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "在打开远程工作区后启动桥接。"
        },
        "codexLocalBridge.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "显式指定模型 ID。留空时自动读取本机目录和当前 Codex 模型；多候选时选择，均不可用时手动输入。"
        },
        "codexLocalBridge.claudeModel": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Claude 路由实际支持的模型 ID；留空时使用 Claude 命令会询问，不复用 Codex 模型。生成配置时三个模型档位先映射到此模型，可手动细分。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blacker521/codex-local-bridge.git",
    "directory": "remote"
  },
  "homepage": "https://github.com/blacker521/codex-local-bridge#readme",
  "bugs": {
    "url": "https://github.com/blacker521/codex-local-bridge/issues"
  }
}
